{
  "name": "dashi-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p packages/file-uploads-none/tsconfig.build.json && tsc -p packages/dashi/tsconfig.build.json",
    "dev": "pnpm run build && node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint packages scripts",
    "test": "vitest run",
    "gate": "node scripts/gate.mjs",
    "gate:docker": "docker build --tag dashi-gate . && docker run --rm --env CI --env HOST_UID=\"$(id -u)\" --env HOST_GID=\"$(id -g)\" --security-opt seccomp=unconfined --security-opt apparmor=unconfined --security-opt systempaths=unconfined --volume \"$PWD:/workspace\" --volume /workspace/.pnpm-store --volume /workspace/node_modules --volume /workspace/packages/dashi/node_modules --volume /workspace/packages/dashi-app/node_modules --volume /workspace/packages/dashi-launcher/node_modules --volume /workspace/packages/file-uploads-none/node_modules dashi-gate"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "catalog:",
    "@deepseek-ai/dsh-anonymous-user-id": "catalog:",
    "@deepseek-ai/dsh-agent-loop": "catalog:",
    "@deepseek-ai/dsh-agent-loop-testkit": "catalog:",
    "@deepseek-ai/dsh-bash-local": "catalog:",
    "@deepseek-ai/dsh-brand": "catalog:",
    "@deepseek-ai/dsh-hook-protocol": "catalog:",
    "@deepseek-ai/dsh-llm-replay": "catalog:",
    "@deepseek-ai/dsh-output-retention": "catalog:",
    "@deepseek-ai/dsh-sandbox": "catalog:",
    "@deepseek-ai/dsh-sandbox-policy": "catalog:",
    "@deepseek-ai/dsh-schedule": "catalog:",
    "@deepseek-ai/dsh-sdk-protocol": "catalog:",
    "@deepseek-ai/dsh-session-persistence": "catalog:",
    "@deepseek-ai/dsh-session-persistence-jsonl": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-session-telemetry": "catalog:",
    "@deepseek-ai/dsh-session-title-llm": "catalog:",
    "@deepseek-ai/dsh-spill": "catalog:",
    "@deepseek-ai/dsh-subagent-in-process-driver": "catalog:",
    "@deepseek-ai/dsh-util-time": "catalog:",
    "@deepseek-ai/dsh-util-values": "catalog:",
    "@deepseek-ai/dsh-util-workspace-path": "catalog:",
    "@deepseek-ai/dsh-workflow": "catalog:",
    "@xterm/headless": "6.0.0",
    "@types/node": "22.20.0",
    "node-pty": "1.2.0-beta.15",
    "oxlint": "1.76.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
